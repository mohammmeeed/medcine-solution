<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Ne pas rediriger les appels d'API PHP vers index.html
  RewriteCond %{REQUEST_URI} ^/backend/ [NC]
  RewriteRule .* - [L]

  # 2. Servir les fichiers et dossiers réels (ex: static/js, static/css, doctor.jpg, favicon)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Toutes les autres routes React (/admin, /login, /dashboard, etc.) renvoient vers index.html
  RewriteRule ^ index.html [L]
</IfModule>
